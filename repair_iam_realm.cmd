@echo off
setlocal
if not exist "keycloak\build-realm.mjs" (
  echo ERROR: Run this CMD file from the ganpat-iam project root.
  echo Expected: keycloak\build-realm.mjs
  pause
  exit /b 1
)
copy /Y "keycloak\build-realm.mjs" "keycloak\build-realm.mjs.broken-backup" >nul
if errorlevel 1 (echo ERROR: Could not back up existing file.& pause & exit /b 1)
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ ; [IO.File]::WriteAllBytes('keycloak\build-realm.mjs',[Convert]::FromBase64String($b))"
if errorlevel 1 (echo ERROR: Could not write repaired file.& pause & exit /b 1)
echo Checking JavaScript syntax...
node --check keycloak\build-realm.mjs
if errorlevel 1 (echo ERROR: Syntax check failed. Backup: keycloak\build-realm.mjs.broken-backup& pause & exit /b 1)
echo Regenerating realm JSON...
node keycloak\build-realm.mjs
if errorlevel 1 (echo ERROR: Realm generation failed.& pause & exit /b 1)
echo Verifying Subject mapper...
findstr /N /I "oidc-sub-mapper" keycloak\realm\ganpat-iam-realm.json
echo.
echo DONE. Original file backed up as keycloak\build-realm.mjs.broken-backup
echo NOTE: This updates the JSON file only, not the already-running Keycloak realm.
pause
